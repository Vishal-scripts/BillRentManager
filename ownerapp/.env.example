# Copy to ownerapp/.env on this PC. Setup.bat writes the email and mobile.
# Never commit .env. Do not put a PIN here. The first page asks for one,
# and users.env stores a hash. 0000 and 1234 are rejected.

PORT=8765

# Set to 1 to listen for phones on this Wi-Fi. Settings can do the same.
# PHONE_ACCESS=1

# Set to 1 for HTTPS so a phone can show system alerts. Needs openssl once.
# HTTPS=1

# Tata Power's form asks for an email. Use the owner's. Nothing is paid.
RECEIPT_EMAIL=owner@example.com
RECEIPT_MOBILE=98xxxxxxxx

REQUEST_DELAY_SECONDS=3
NDPL_CAPTCHA_TRIES=6
