# Copy to ownerapp/.env on this PC. Setup.bat writes it. Never commit .env.

# 4 to 8 digits. People on the same Wi-Fi need this PIN.
OWNER_PIN=0000

PORT=8765

# Tata Power's form asks for an email. Use the owner's. Nothing is paid.
RECEIPT_EMAIL=owner@example.com
RECEIPT_MOBILE=98xxxxxxxx

REQUEST_DELAY_SECONDS=3
NDPL_CAPTCHA_TRIES=6
