# Optional. Start-App uses ownerapp/.env, not this file.
# check_bills.py --demo does not need it. A live CSV run can set the email here.

WEBAPP_URL=
WEBAPP_TOKEN=

# The pay-bill form asks for an email (required) and a mobile for the e-receipt.
# Use the OWNER's details. The script never continues into card payment.
RECEIPT_EMAIL=owner@example.com
RECEIPT_MOBILE=98xxxxxxxx

# Seconds between CA numbers. The script refuses anything below 2.
REQUEST_DELAY_SECONDS=3

# Captcha images to try for each CA before marking it Error. Default 6.
# A failed read refreshes the image (Change Image) or reloads the page.
# CAs that still fail are tried once more at the end of the run.
NDPL_CAPTCHA_TRIES=6

# Only if `tesseract` is not on PATH. UB Mannheim's Windows build:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

NDPL_PAY_URL=https://www.tatapower-ddl.com/billpay/paybillonline.aspx
